# Node.js >= 24. 本地独立运行；不要提交真实密钥。
PORT=4318
DATA_DIR=./data
PUBLIC_API_TIMEOUT_MS=20000

# 可选：未配置时只有真实 MCP 的规则预览，不满足最终 AI 调用验收。
# 使用支持 Chat Completions function calling 的 OpenAI-compatible 模型服务。
# MODEL_API_KEY=
# MODEL_BASE_URL=https://api.openai.com/v1
# MODEL_NAME=

# DeepSeek 官方接口示例（模型名按 2026-10-27 官方文档）：
# MODEL_API_KEY=在本机 .env 中填写，勿提交
# MODEL_BASE_URL=https://api.deepseek.com
# MODEL_NAME=deepseek-flash
# 官方 DeepSeek 主机使用非思考工具调用模式；仍须实际运行验证。
